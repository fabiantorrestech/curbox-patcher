@@ -0,0 +1,81 @@
+package neth.iecal.curbox.anti_stimulants
+
+/**
+ * Decides when Curbox may switch the system grayscale filter, so it never fights a filter the
+ * user or another app (e.g. GrayScaler+) switched on.
+ *
+ * Rules:
+ * - Curbox only switches the filter on when it is off, and only owns it once it is seen on.
+ * - Curbox only switches the filter off when it owns it and it is still on.
+ * - One command at a time: Shizuku runs each command on its own thread, so a later "off" could
+ *   otherwise land before an earlier "on". Requests made while a command is pending are queued
+ *   (latest wins) and replayed once the command lands or times out.
+ * - If the filter goes off while Curbox owns it and nothing is pending, someone else switched it
+ *   off, so Curbox gives up ownership and will not touch a later "on".
+ *
+ * Pure logic with no Android dependencies; [GrayscaleOwner] feeds it what the system reports and
+ * executes the returned commands.
+ */
+internal class GrayscaleOwnership(owned: Boolean = false) {
+
+    enum class Command { ENABLE, DISABLE, NONE }
+
+    var owned: Boolean = owned
+        private set
+
+    /** Target state of the command in flight, or null when nothing is pending. */
+    var pending: Boolean? = null
+        private set
+
+    private var queued: Boolean? = null
+
+    /** Curbox wants the filter on ([wants] = true) or off for the app in front. */
+    fun request(wants: Boolean, systemOn: Boolean): Command {
+        if (pending != null) {
+            queued = wants
+            return Command.NONE
+        }
+        if (owned && !systemOn) owned = false
+
+        return when {
+            wants && !systemOn -> {
+                pending = true
+                Command.ENABLE
+            }
+            !wants && owned -> {
+                pending = false
+                Command.DISABLE
+            }
+            else -> Command.NONE
+        }
+    }
+
+    /** The system filter state changed, or was read right after a command was issued. */
+    fun observed(systemOn: Boolean): Command {
+        val target = pending
+        if (target == null) {
+            if (owned && !systemOn) owned = false
+            return Command.NONE
+        }
+        if (systemOn != target) return Command.NONE
+
+        owned = target
+        pending = null
+        return replayQueued(systemOn)
+    }
+
+    /** The pending command did not show up in time. */
+    fun timedOut(systemOn: Boolean): Command {
+        val target = pending ?: return Command.NONE
+        pending = null
+        // A failed enable leaves nothing of ours on; a failed disable leaves our filter on.
+        owned = if (target) false else systemOn
+        return replayQueued(systemOn)
+    }
+
+    private fun replayQueued(systemOn: Boolean): Command {
+        val next = queued ?: return Command.NONE
+        queued = null
+        return request(next, systemOn)
+    }
+}
diff --git a/app/src/test/java/neth/iecal/curbox/anti_stimulants/GrayscaleOwnershipTest.kt b/app/src/test/java/neth/iecal/curbox/anti_stimulants/GrayscaleOwnershipTest.kt
new file mode 100644
index 00000000..89cd8b25
--- /dev/null
+++ b/app/src/test/java/neth/iecal/curbox/anti_stimulants/GrayscaleOwnershipTest.kt
@@ -0,0 +1,128 @@
+package neth.iecal.curbox.anti_stimulants
+
+import neth.iecal.curbox.anti_stimulants.GrayscaleOwnership.Command
+import org.junit.Assert.assertEquals
+import org.junit.Assert.assertFalse
+import org.junit.Assert.assertNull
+import org.junit.Assert.assertTrue
+import org.junit.Test
+
+class GrayscaleOwnershipTest {
+
+    // Core guarantee: with no group asking for grayscale, Curbox never writes the setting.
+
+    @Test
+    fun notWantedNeverTouchesSomeoneElsesFilter() {
+        val ownership = GrayscaleOwnership()
+        assertEquals(Command.NONE, ownership.request(wants = false, systemOn = true))
+        assertEquals(Command.NONE, ownership.request(wants = false, systemOn = false))
+        assertFalse(ownership.owned)
+    }
+
+    @Test
+    fun wantedWhileSomeoneElsesFilterIsOnIsNotClaimed() {
+        val ownership = GrayscaleOwnership()
+        assertEquals(Command.NONE, ownership.request(wants = true, systemOn = true))
+        assertFalse(ownership.owned)
+        assertEquals(Command.NONE, ownership.request(wants = false, systemOn = true))
+    }
+
+    // Normal cycle
+
+    @Test
+    fun enableThenDisableOwnFilter() {
+        val ownership = GrayscaleOwnership()
+        assertEquals(Command.ENABLE, ownership.request(wants = true, systemOn = false))
+        assertFalse("not owned until seen on", ownership.owned)
+
+        assertEquals(Command.NONE, ownership.observed(systemOn = true))
+        assertTrue(ownership.owned)
+        assertNull(ownership.pending)
+
+        assertEquals(Command.DISABLE, ownership.request(wants = false, systemOn = true))
+        assertEquals(Command.NONE, ownership.observed(systemOn = false))
+        assertFalse(ownership.owned)
+    }
+
+    // Issue 1: an enable that never landed must not leave Curbox owning a later filter.
+
+    @Test
+    fun failedEnableDoesNotClaimOwnership() {
+        val ownership = GrayscaleOwnership()
+        ownership.request(wants = true, systemOn = false)
+        assertEquals(Command.NONE, ownership.timedOut(systemOn = false))
+        assertFalse(ownership.owned)
+
+        // GrayScaler+ switches the filter on later; leaving the app must not switch it off.
+        assertEquals(Command.NONE, ownership.request(wants = false, systemOn = true))
+    }
+
+    // Issue 2: someone else switched Curbox's filter off and later on again.
+
+    @Test
+    fun takeoverByAnotherAppDropsOwnership() {
+        val ownership = GrayscaleOwnership(owned = true)
+        assertEquals(Command.NONE, ownership.observed(systemOn = false))
+        assertFalse(ownership.owned)
+
+        assertEquals(Command.NONE, ownership.observed(systemOn = true))
+        assertEquals(Command.NONE, ownership.request(wants = false, systemOn = true))
+    }
+
+    @Test
+    fun ownershipDroppedOnRequestIfFilterWentOffUnseen() {
+        val ownership = GrayscaleOwnership(owned = true)
+        assertEquals(Command.NONE, ownership.request(wants = false, systemOn = false))
+        assertFalse(ownership.owned)
+    }
+
+    // Issue 3: Shizuku commands run on separate threads, so they are serialized here.
+
+    @Test
+    fun disableWaitsForPendingEnable() {
+        val ownership = GrayscaleOwnership()
+        assertEquals(Command.ENABLE, ownership.request(wants = true, systemOn = false))
+        assertEquals("queued, not sent", Command.NONE, ownership.request(wants = false, systemOn = false))
+
+        assertEquals(Command.DISABLE, ownership.observed(systemOn = true))
+        assertEquals(Command.NONE, ownership.observed(systemOn = false))
+        assertFalse(ownership.owned)
+        assertNull(ownership.pending)
+    }
+
+    @Test
+    fun latestQueuedRequestWins() {
+        val ownership = GrayscaleOwnership()
+        ownership.request(wants = true, systemOn = false)
+        ownership.request(wants = false, systemOn = false)
+        ownership.request(wants = true, systemOn = false)
+
+        assertEquals(Command.NONE, ownership.observed(systemOn = true))
+        assertTrue(ownership.owned)
+    }
+
+    @Test
+    fun queuedRequestReplaysAfterTimeout() {
+        val ownership = GrayscaleOwnership()
+        ownership.request(wants = true, systemOn = false)
+        ownership.request(wants = true, systemOn = false)
+        assertEquals("retries the enable", Command.ENABLE, ownership.timedOut(systemOn = false))
+    }
+
+    @Test
+    fun failedDisableKeepsOwnership() {
+        val ownership = GrayscaleOwnership(owned = true)
+        ownership.request(wants = false, systemOn = true)
+        ownership.timedOut(systemOn = true)
+        assertTrue(ownership.owned)
+    }
+
+    // Restart: persisted ownership is honored only while the filter is still on.
+
+    @Test
+    fun restoredOwnershipStillDisables() {
+        val ownership = GrayscaleOwnership(owned = true)
+        assertEquals(Command.NONE, ownership.observed(systemOn = true))
+        assertEquals(Command.DISABLE, ownership.request(wants = false, systemOn = true))
+    }
+}
